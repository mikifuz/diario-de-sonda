# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API).
# Estas duas chaves são públicas por natureza: a proteção dos dados vem das
# políticas de segurança (RLS) do banco. Nunca coloque a "service_role" aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
