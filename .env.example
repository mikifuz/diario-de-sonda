# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API).
# Estas duas chaves são públicas por natureza: a proteção dos dados vem das
# políticas de segurança (RLS) do banco. Nunca coloque a "service_role" aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Avisos no celular (opcional). As três últimas são SECRETAS: só na Vercel e no .env.local,
# nunca no código. Gere as chaves VAPID com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
